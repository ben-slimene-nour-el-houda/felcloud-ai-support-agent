# Environment variables for Felcloud AI Support Agent
# DO NOT include real secrets or credentials in this file.
# Copy this file to .env and fill in the values for local development.

# Application
ENVIRONMENT="development"

# LLM / LiteLLM
LLM_BASE_URL="http://localhost:4000/v1"
LLM_API_KEY="sk-placeholder-key"
GENERATION_MODEL="llama3-70b-8192"
STRUCTURED_OUTPUT_MODEL="llama3-70b-8192"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="felcloud_knowledge"
QDRANT_PORT=6333

# PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="felcloud_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_placeholder"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis_password_placeholder"

# JWT / Auth
JWT_SECRET_KEY="jwt_secret_placeholder_generate_with_secrets_token_urlsafe"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=60

# ZeroClaw
ZEROCLAW_WEBHOOK_SECRET="zeroclaw_secret_placeholder"
ZEROCLAW_WEBHOOK_PATH="/webhook/zeroclaw"
ZEROCLAW_WEBHOOK_HOST="0.0.0.0"
ZEROCLAW_WEBHOOK_PORT=8001
ZEROCLAW_API_URL="https://your-zeroclaw-instance.example.com"
ZEROCLAW_API_KEY="zeroclaw_api_key_placeholder"

# Ticketing (optional — set to enable live ticketing API)
TICKETING_API_URL="https://your-ticketing-api.example.com"
TICKETING_API_KEY="ticketing_api_key_placeholder"

TICKETING_API_URL="https://your-ticketing-api.example.com"
TICKETING_API_KEY="ticketing_api_key_placeholder"

# Embeddings
EMBEDDING_DEVICE="auto"
EMBEDDING_BATCH_SIZE=32
EMBEDDING_USE_COLBERT="false"
